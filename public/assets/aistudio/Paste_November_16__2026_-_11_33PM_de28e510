              <p className="text-xs text-slate-500 py-4 text-center">
                Belum ada data nilai santri yang masuk.
              </p>
            ) : (
              <div className="space-y-2.5">
                {scoresToDisplay.map((r, i) => (
                  <div
                    key={i}
                    className="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 flex items-center justify-between"
                  >
                    <div>
                      <p className="font-bold text-sm text-[#0A192F]">
                        {r.nama_santri}{' '}
                        <span className="text-xs font-normal text-slate-500">
                          ({r.kode_santri || 'GUEST'})
                        </span>
                      </p>
                      <p className="text-[11px] text-slate-500">
                        Tingkat {r.tingkatan} • {r.jenis_kuis} • {r.mode_belajar}
                      </p>
                    </div>
                    <span className="px-3 py-1.5 rounded-xl bg-[#0A192F] text-[#D4AF37] font-extrabold text-sm">
                      {r.skor}
                    </span>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}

        {/* Tab 2: Kelola Kode & PIN Santri */}
        {guruTab === 'santri' && (
          <div className="space-y-4">
            <form
              onSubmit={handleAddSantri}
              className="bg-white rounded-3xl p-5 border border-slate-200 space-y-3.5"
            >
              <h3 className="font-bold text-sm text-[#0A192F]">Tambah Akun Santri Baru</h3>
              <div className="grid grid-cols-2 gap-2.5">
                <input
                  type="text"
                  placeholder="Kode (mis: MQ-004)"
                  value={newSantriKode}
                  onChange={(e) => setNewSantriKode(e.target.value)}
                  className="px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs"
                />
                <input
                  type="text"
                  placeholder="PIN (mis: 1234)"
                  value={newSantriPin}
                  onChange={(e) => setNewSantriPin(e.target.value)}
                  className="px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs"
                />
              </div>
              <input
                type="text"
                placeholder="Nama lengkap santri"
                value={newSantriNama}
                onChange={(e) => setNewSantriNama(e.target.value)}
                className="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs"
              />
              <select
                value={newSantriTingkatan}
                onChange={(e) => setNewSantriTingkatan(e.target.value as Tingkatan)}
                className="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-bold text-[#0A192F]"
              >
                <option value="Dasar">Tingkat Dasar (Juz 29 & 30)</option>
                <option value="Menengah">Tingkat Menengah (Juz 21 - 30)</option>
                <option value="Mahir">Tingkat Mahir (30 Juz)</option>
              </select>
              <button
                type="submit"
                className="w-full py-3 rounded-xl bg-[#0A192F] text-[#D4AF37] font-bold text-xs"
              >
                + Simpan Akun Santri
              </button>
            </form>

            <div className="bg-white rounded-3xl p-5 border border-slate-200 space-y-2.5">
              <h4 className="font-bold text-sm text-[#0A192F]">Daftar Akun Santri Aktif</h4>
              {santriList.map((s, idx) => (
                <div
                  key={idx}
                  className="p-3 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-between text-xs"
                >
                  <div>
                    <p className="font-bold text-[#0A192F]">{s.nama_lengkap}</p>
                    <p className="text-slate-500">
                      Kode: <strong>{s.kode_santri}</strong> • PIN: <strong>{s.pin_santri}</strong>
                    </p>
                  </div>
                  <span className="px-2.5 py-1 rounded-lg bg-amber-100 text-[#8A6914] font-bold">
                    {s.tingkatan}
                  </span>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Tab 3: Koneksi Supabase & Ganti Logo */}
        {guruTab === 'pengaturan' && (
          <form
            onSubmit={handleSaveSupabaseConfig}
            className="bg-white rounded-3xl p-5 border border-slate-200 space-y-4"
          >
            <h3 className="font-bold text-sm text-[#0A192F]">
              Koneksi Database Supabase & Logo Markaz
            </h3>
            <div>
              <label className="block text-xs font-bold text-slate-700 mb-1">
                URL Logo Markaz (Opsional)
              </label>
              <input
                type="text"
                value={logoUrl}
                onChange={(e) => setLogoUrl(e.target.value)}
                placeholder="https://.../logo.png"
                className="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs"
              />
            </div>
            <div>
              <label className="block text-xs font-bold text-slate-700 mb-1">
                Supabase Project URL
              </label>
              <input
                type="text"
                value={sbUrl}
                onChange={(e) => setSbUrl(e.target.value)}
                placeholder="https://xxxx.supabase.co"
                className="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs"
              />
            </div>
            <div>
              <label className="block text-xs font-bold text-slate-700 mb-1">
                Supabase Anon Public Key
              </label>
              <input
                type="password"
                value={sbKey}
                onChange={(e) => setSbKey(e.target.value)}
                placeholder="eyJhbGciOiJIUzI1NiIsInR5c..."
                className="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs"
              />
            </div>
            <button
              type="submit"
              className="w-full py-3 rounded-xl bg-[#0A192F] text-[#D4AF37] font-bold text-xs"
            >
              Simpan Konfigurasi
            </button>
          </form>
        )}
      </div>
    );
  };

  // ==========================================
  // RENDER UTAMA
  // ==========================================
  return (
    <div className="min-h-screen bg-[#F8FAFC] text-slate-800 flex flex-col font-sans">
      {renderHeader()}
      {renderDrawer()}

      <main className="flex-1 max-w-md w-full mx-auto px-4 py-6">
        {currentView === 'auth' && renderAuthView()}
        {currentView === 'home' && renderHomeView()}
        {currentView === 'study_setup' && renderStudySetupView()}
        {currentView === 'quiz_active' && renderQuizActiveView()}
        {currentView === 'quiz_result' && renderQuizResultView()}
        {currentView === 'rapor' && renderRaporView()}
        {currentView === 'guru_login' && renderGuruLoginView()}
        {currentView === 'guru_dashboard' && renderGuruDashboardView()}
        {currentView === 'about' && (
          <div className="bg-white rounded-3xl p-6 border border-slate-200 space-y-3">
            <h2 className="font-extrabold text-lg text-[#0A192F]">
              Markaz Al-Qur'an Abdurrahman bin 'Auf
            </h2>
            <p className="text-xs text-slate-600 leading-relaxed">
              Aplikasi evaluasi hafalan (Sambung Ayat 30 Juz) dan Pengetahuan Agama Islam dengan pembagian tingkatan Dasar (Juz 29–30), Menengah (Juz 21–30), dan Mahir (30 Juz).
            </p>
            <button
              onClick={() => setCurrentView(user ? 'home' : 'auth')}
              className="px-4 py-2 rounded-xl bg-[#0A192F] text-[#D4AF37] text-xs font-bold"
            >
              Kembali
            </button>
          </div>
        )}
      </main>

      <footer className="py-6 text-center text-[11px] text-slate-400 space-y-1 border-t border-slate-200/60 bg-white">
        <p className="font-semibold text-[#0A192F]">
          Markaz Al-Qur'an Abdurrahman bin 'Auf • Belajar, Muraja'ah, Bertumbuh
        </p>
        <p>Teks Ayat: AlQuran Cloud / Quran.com • Audio: Mishary Rashid Al-Afasy</p>
      </footer>
    </div>
  );
}