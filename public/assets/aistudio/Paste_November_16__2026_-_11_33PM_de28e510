                  : 'bg-white border-slate-200'
              }`}
            >
              <div className="text-2xl mb-2">🌱</div>
              <h4 className="font-bold text-sm text-[#0A192F]">Latihan Bebas</h4>
              <p className="text-[11px] text-slate-500 mt-1 leading-relaxed">
                Jawaban langsung dikoreksi di setiap soal. Cocok untuk muraja'ah mandiri.
              </p>
            </div>

            <div
              onClick={() => setStudyMode('Ujian / Setoran')}
              className={`p-4 rounded-3xl border cursor-pointer transition ${
                studyMode === 'Ujian / Setoran'
                  ? 'border-[#0A192F] bg-[#0A192F]/5 ring-2 ring-[#D4AF37]'
                  : 'bg-white border-slate-200'
              }`}
            >
              <div className="text-2xl mb-2">📝</div>
              <h4 className="font-bold text-sm text-[#0A192F]">Ujian / Setoran</h4>
              <p className="text-[11px] text-slate-500 mt-1 leading-relaxed">
                Kunci jawaban ditampilkan di akhir. Nilai langsung masuk rapor santri.
              </p>
            </div>
          </div>
        </div>

        {/* Pilihan Jenis Kuis */}
        <div>
          <h3 className="font-extrabold text-base text-[#0A192F] mb-3">Jenis kuis</h3>
          <div className="space-y-2.5">
            <div
              onClick={() => setQuizType('Sambung Ayat')}
              className={`p-4 rounded-2xl border cursor-pointer transition flex items-center gap-3.5 ${
                quizType === 'Sambung Ayat'
                  ? 'border-[#0A192F] bg-[#0A192F]/5 ring-1 ring-[#D4AF37]'
                  : 'bg-white border-slate-200'
              }`}
            >
              <div className="text-2xl">📖</div>
              <div>
                <h4 className="font-bold text-sm text-[#0A192F]">
                  Kuis Hafalan — Sambung Ayat
                </h4>
                <p className="text-xs text-slate-500 mt-0.5">
                  Melanjutkan ayat Al-Qur'an ({TINGKATAN_INFO[user.tingkatan].desc}) + Audio Murottal.
                </p>
              </div>
            </div>

            <div
              onClick={() => setQuizType('Pengetahuan Agama')}
              className={`p-4 rounded-2xl border cursor-pointer transition flex items-center gap-3.5 ${
                quizType === 'Pengetahuan Agama'
                  ? 'border-[#0A192F] bg-[#0A192F]/5 ring-1 ring-[#D4AF37]'
                  : 'bg-white border-slate-200'
              }`}
            >
              <div className="text-2xl">🕌</div>
              <div>
                <h4 className="font-bold text-sm text-[#0A192F]">
                  Kuis Pengetahuan Agama
                </h4>
                <p className="text-xs text-slate-500 mt-0.5">
                  Soal tajwid, ulumul Qur'an, sirah nabawiyah, dan adab penuntut ilmu.
                </p>
              </div>
            </div>
          </div>
        </div>

        {/* Pilihan Jumlah Soal */}
        <div>
          <div className="flex items-center justify-between mb-3">
            <h3 className="font-extrabold text-base text-[#0A192F]">Jumlah soal</h3>
            <span className="text-xs text-slate-500">{TINGKATAN_INFO[user.tingkatan].desc}</span>
          </div>

          <div className="grid grid-cols-3 gap-2.5">
            {([5, 10, 40] as const).map((cnt) => (
              <button
                key={cnt}
                type="button"
                onClick={() => setQuestionCount(cnt)}
                className={`py-3 rounded-2xl font-bold text-xs border transition ${
                  questionCount === cnt
                    ? 'bg-[#0A192F] text-[#D4AF37] border-[#D4AF37]'
                    : 'bg-white text-[#0A192F] border-slate-200 hover:bg-slate-50'
                }`}
              >
                {cnt} Soal
              </button>
            ))}
          </div>
        </div>

        {/* Tombol Mulai Kuis */}
        <button
          type="button"
          onClick={startQuiz}
          disabled={isGeneratingQuiz}
          className="w-full py-4 rounded-2xl bg-[#0A192F] hover:bg-[#112240] text-[#D4AF37] font-extrabold text-sm shadow-lg border border-[#D4AF37]/50 transition flex items-center justify-center gap-2"
        >
          {isGeneratingQuiz ? (
            <>
              <RefreshCw className="w-4 h-4 animate-spin" />
              <span>Menyiapkan Ayat & Audio ({user.tingkatan})...</span>
            </>
          ) : (
            <>
              <span>Mulai {studyMode} Sekarang</span>
              <ArrowRight className="w-4 h-4" />
            </>
          )}
        </button>
      </div>
    );
  };

  // ==========================================
  // 4. LAYAR PENGERJAAN KUIS INTERAKTIF
  // ==========================================
  const renderQuizActiveView = () => {
    const q = questions[currentQIndex];
    if (!q) return null;

    return (
      <div className="space-y-5">
        <audio
          ref={audioRef}
          onEnded={() => setIsPlayingAudio(false)}
          className="hidden"
        />

        <div className="flex items-center justify-between">
          <button
            onClick={() => {
              if (audioRef.current) audioRef.current.pause();
              setCurrentView('study_setup');
            }}
            className="inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-[#0A192F]"
          >
            <ArrowLeft className="w-4 h-4" />
            <span>Batalkan</span>
          </button>
          <span className="px-3 py-1 rounded-full bg-[#0A192F] text-[#D4AF37] text-xs font-bold">
            Soal {currentQIndex + 1} / {questions.length}
          </span>
        </div>

        {/* Kartu Pertanyaan & Ayat */}
        <div className="bg-white rounded-3xl p-5 border border-slate-200 shadow-xs space-y-4">
          <div className="flex items-center justify-between">
            <span className="text-[11px] font-bold uppercase tracking-wider text-[#B58E24]">
              {studyMode} • Tingkat {user?.tingkatan}
            </span>
            {q.surahName && (
              <span className="text-xs font-semibold text-slate-500">
                {q.surahName} : {q.ayahNumber}
              </span>
            )}
          </div>

          <p className="text-sm font-bold text-[#0A192F]">{q.questionText}</p>

          {q.arabicPrompt && (
            <div className="p-5 rounded-2xl bg-slate-50 border border-[#D4AF37]/40 text-right">
              <p
                dir="rtl"
                className="text-2xl leading-loose font-serif text-[#0A192F]"
              >
                {q.arabicPrompt}
              </p>
            </div>
          )}

          {q.audioUrl && (
            <button
              type="button"
              onClick={() => toggleAudio(q.audioUrl)}
              className="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#0A192F] text-[#D4AF37] text-xs font-bold shadow-xs hover:bg-[#112240] transition"
            >
              {isPlayingAudio ? (
                <>
                  <Pause className="w-4 h-4" />
                  <span>Jeda Murottal</span>
                </>
              ) : (
                <>
                  <Volume2 className="w-4 h-4" />
                  <span>Putar Audio Murottal Ayat</span>
                </>
              )}
            </button>
          )}
        </div>

        {/* Pilihan Jawaban A, B, C, D */}
        <div className="space-y-2.5">
          {q.options.map((opt, idx) => {
            const isSelected = selectedOption === idx;
            const isCorrect = idx === q.correctIndex;
            let btnStyle = 'bg-white border-slate-200 text-[#0A192F] hover:border-[#0A192F]';

            if (studyMode === 'Latihan Bebas' && isAnswerSubmitted) {
              if (isCorrect) {
                btnStyle = 'bg-emerald-50 border-emerald-500 text-emerald-900 ring-1 ring-emerald-500';
              } else if (isSelected && !isCorrect) {
                btnStyle = 'bg-rose-50 border-rose-500 text-rose-900';
              }
            } else if (isSelected) {
              btnStyle = 'bg-[#0A192F] text-[#D4AF37] border-[#D4AF37]';
            }

            return (
              <button
                key={idx}
                type="button"
                onClick={() => handleSelectOption(idx)}
                className={`w-full p-4 rounded-2xl border text-left transition flex items-center justify-between gap-3 ${btnStyle}`}
              >
                <span className="w-7 h-7 rounded-lg bg-black/10 flex items-center justify-center font-bold text-xs shrink-0">
                  {String.fromCharCode(65 + idx)}
                </span>
                <span
                  dir={q.arabicPrompt ? 'rtl' : 'ltr'}
                  className={`flex-1 ${
                    q.arabicPrompt ? 'text-xl font-serif leading-relaxed text-right' : 'text-sm font-semibold'
                  }`}
                >
                  {opt}
                </span>
              </button>
            );
          })}
        </div>

        {/* Umpan Balik Langsung (Khusus Mode Latihan Bebas) */}
        {studyMode === 'Latihan Bebas' && isAnswerSubmitted && (
          <div
            className={`p-4 rounded-2xl border text-xs leading-relaxed ${
              selectedOption === q.correctIndex
                ? 'bg-emerald-50 border-emerald-200 text-emerald-800'
                : 'bg-rose-50 border-rose-200 text-rose-800'
            }`}
          >
            <p className="font-bold mb-1">
              {selectedOption === q.correctIndex
                ? 'Mumtaz! Jawabanmu Benar.'
                : 'Kurang tepat. Tetap semangat muraja’ah!'}
            </p>
            <p>{q.explanation}</p>
          </div>
        )}

        <button
          type="button"
          disabled={selectedOption === null}
          onClick={handleNextQuestion}
          className="w-full py-3.5 rounded-2xl bg-[#0A192F] disabled:opacity-40 text-[#D4AF37] font-bold text-sm shadow-md transition"
        >
          {currentQIndex + 1 === questions.length ? 'Selesaikan & Lihat Nilai' : 'Soal Berikutnya →'}
        </button>
      </div>
    );
  };

  // ==========================================
  // 5. LAYAR HASIL KUIS & RAPOR SANTRI
  // ==========================================
  const renderQuizResultView = () => {
    const latest = localScores[0];
    if (!latest) return null;

    return (
      <div className="space-y-6 text-center">
        <div className="bg-gradient-to-br from-[#0A192F] to-[#112240] text-white p-7 rounded-3xl border border-[#D4AF37]/40 shadow-lg">
          <Trophy className="w-14 h-14 text-[#D4AF37] mx-auto mb-3" />
          <p className="text-xs uppercase tracking-widest text-[#D4AF37] font-bold">
            HASIL {latest.mode_belajar.toUpperCase()}
          </p>
          <h2 className="text-4xl font-extrabold my-2 text-white">{latest.skor}</h2>
          <p className="text-xs text-slate-300">
            Benar {latest.benar} dari {latest.jumlah_soal} Soal • Tingkat {latest.tingkatan}
          </p>
        </div>

        <div className="flex gap-3">
          <button
            onClick={() => setCurrentView('study_setup')}
            className="flex-1 py-3.5 rounded-2xl bg-white border border-slate-300 font-bold text-xs text-[#0A192F]"
          >
            Ulangi Kuis
          </button>
          <button
            onClick={() => setCurrentView('rapor')}
            className="flex-1 py-3.5 rounded-2xl bg-[#0A192F] text-[#D4AF37] font-bold text-xs"
          >
            Buka Rapor Santri
          </button>
        </div>
      </div>
    );
  };

  const renderRaporView = () => {
    const combinedScores = isSupabaseConfigured && allScores.length > 0 ? allScores : localScores;
    return (
      <div className="space-y-5">
        <button
          onClick={() => setCurrentView('home')}
          className="inline-flex items-center gap-2 text-xs font-bold text-[#0A192F]"
        >
          <ArrowLeft className="w-4 h-4" />
          <span>Kembali ke beranda</span>
        </button>

        <div className="bg-gradient-to-br from-[#0A192F] to-[#112240] text-white p-6 rounded-3xl border border-[#D4AF37]/40">
          <p className="text-[11px] font-bold uppercase tracking-widest text-[#D4AF37]">
            EVALUASI & KLASEMEN
          </p>
          <h2 className="text-xl font-extrabold mt-1">Rapor & Riwayat Nilai</h2>
          <p className="text-xs text-slate-300 mt-1">
            Catatan hasil latihan dan setoran ujian santri Markaz Al-Qur'an.
          </p>
        </div>

        {combinedScores.length === 0 ? (
          <div className="bg-white rounded-3xl p-6 text-center border border-slate-200">
            <p className="text-sm font-bold text-[#0A192F]">Belum ada nilai tercatat</p>
            <p className="text-xs text-slate-500 mt-1">
              Silakan kerjakan Kuis Hafalan atau Pengetahuan Agama terlebih dahulu.
            </p>
          </div>
        ) : (
          <div className="space-y-3">
            {combinedScores.map((item, idx) => (
              <div
                key={idx}
                className="bg-white p-4 rounded-2xl border border-slate-200 flex items-center justify-between"
              >
                <div>
                  <div className="flex items-center gap-2">
                    <span className="font-bold text-sm text-[#0A192F]">{item.nama_santri}</span>
                    <span className="px-2 py-0.5 rounded-md bg-amber-100 text-[#8A6914] text-[10px] font-bold">
                      {item.tingkatan}
                    </span>
                  </div>
                  <p className="text-xs text-slate-500 mt-0.5">
                    {item.jenis_kuis} ({item.mode_belajar}) • Benar {item.benar}/{item.jumlah_soal}
                  </p>
                </div>
                <div className="w-12 h-12 rounded-2xl bg-[#0A192F] text-[#D4AF37] flex items-center justify-center font-extrabold text-base">
                  {item.skor}
                </div>
              </div>
            ))}
          </div>
        )}
      </div>
    );
  };

  // ==========================================
  // 6. LAYAR PANEL GURU (LOGIN & DASHBOARD SUPABASE)
  // ==========================================
  const renderGuruLoginView = () => (
    <div className="space-y-6">
      <button
        onClick={() => setCurrentView(user ? 'home' : 'auth')}
        className="inline-flex items-center gap-2 text-xs font-bold text-[#0A192F]"
      >
        <ArrowLeft className="w-4 h-4" />
        <span>Kembali ke beranda</span>
      </button>

      <div className="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#0A192F] via-[#112240] to-[#1A365D] text-white p-6 shadow-lg border border-[#D4AF37]/30">
        <p className="text-[11px] font-bold tracking-widest uppercase text-[#D4AF37] mb-1.5">
          RUANG PENGAJAR
        </p>
        <h2 className="text-2xl font-extrabold mb-2">Panel Guru</h2>
        <p className="text-xs text-slate-200 leading-relaxed">
          Pantau perkembangan belajar, kelola Kode & PIN santri, dan buka rapor setiap santri.
        </p>
      </div>

      <form
        onSubmit={handleGuruLogin}
        className="bg-white rounded-3xl p-5 border border-slate-200 space-y-4"
      >
        <div>
          <h3 className="font-extrabold text-lg text-[#0A192F]">Masuk sebagai pengajar</h3>
          <p className="text-xs text-slate-500 mt-1 leading-relaxed">
            Akun guru/admin (bukan akun santri). Akun ini membuka rapor, kelola santri, dan koneksi database Supabase.
          </p>
        </div>

        <div>
          <label className="block text-xs font-bold text-[#0A192F] mb-1.5">Email</label>
          <input
            type="email"
            value={guruEmail}
            onChange={(e) => setGuruEmail(e.target.value)}
            placeholder="ustadz@markaz.id"
            className="w-full px-4 py-3 rounded-2xl border border-slate-300 text-sm"
          />
        </div>

        <div>
          <label className="block text-xs font-bold text-[#0A192F] mb-1.5">Kata sandi</label>
          <input
            type="password"
            value={guruPass}
            onChange={(e) => setGuruPass(e.target.value)}
            placeholder="Kata sandi akun guru"
            className="w-full px-4 py-3 rounded-2xl border border-slate-300 text-sm"
          />
        </div>

        <button
          type="submit"
          className="w-full py-3.5 rounded-2xl bg-[#0A192F] text-[#D4AF37] font-bold text-sm shadow-md"
        >
          Masuk ke panel guru
        </button>
      </form>
    </div>
  );

  const renderGuruDashboardView = () => {
    const scoresToDisplay = isSupabaseConfigured && allScores.length > 0 ? allScores : localScores;
    return (
      <div className="space-y-6">
        <div className="flex items-center justify-between">
          <button
            onClick={() => setCurrentView(user ? 'home' : 'auth')}
            className="inline-flex items-center gap-2 text-xs font-bold text-[#0A192F]"
          >
            <ArrowLeft className="w-4 h-4" />
            <span>Beranda</span>
          </button>
          <span className="px-3 py-1 rounded-full bg-amber-100 text-[#8A6914] text-xs font-bold">
            Mode Pengajar Aktif
          </span>
        </div>

        {/* Tab Navigasi Guru */}
        <div className="grid grid-cols-3 gap-2 bg-slate-100 p-1.5 rounded-2xl">
          <button
            onClick={() => setGuruTab('rapor')}
            className={`py-2.5 rounded-xl font-bold text-xs ${
              guruTab === 'rapor' ? 'bg-[#0A192F] text-[#D4AF37]' : 'bg-white text-slate-700'
            }`}
          >
            Rapor Nilai
          </button>
          <button
            onClick={() => setGuruTab('santri')}
            className={`py-2.5 rounded-xl font-bold text-xs ${
              guruTab === 'santri' ? 'bg-[#0A192F] text-[#D4AF37]' : 'bg-white text-slate-700'
            }`}
          >
            Data Santri
          </button>
          <button
            onClick={() => setGuruTab('pengaturan')}
            className={`py-2.5 rounded-xl font-bold text-xs ${
              guruTab === 'pengaturan' ? 'bg-[#0A192F] text-[#D4AF37]' : 'bg-white text-slate-700'
            }`}
          >
            Supabase & Logo
          </button>
        </div>

        {/* Tab 1: Rekap Rapor Santri */}
        {guruTab === 'rapor' && (
          <div className="bg-white rounded-3xl p-5 border border-slate-200 space-y-4">
            <div className="flex items-center justify-between">
              <h3 className="font-bold text-base text-[#0A192F]">Rekap Nilai Seluruh Santri</h3>
              <button
                onClick={syncFromSupabase}
                className="text-xs font-bold text-[#B58E24] flex items-center gap-1"
              >
                <RefreshCw className="w-3.5 h-3.5" /> Segarkan
              </button>
