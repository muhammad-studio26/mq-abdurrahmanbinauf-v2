              className="w-full px-4 py-3 rounded-2xl border border-slate-300 text-sm focus:outline-none focus:border-[#0A192F]"
            />
          </div>

          {authError && (
            <p className="text-xs font-semibold text-rose-600 bg-rose-50 p-3 rounded-xl">
              {authError}
            </p>
          )}

          <button
            type="submit"
            disabled={isLoading}
            className="w-full py-3.5 rounded-2xl bg-[#0A192F] hover:bg-[#112240] text-[#D4AF37] font-bold text-sm shadow-md transition border border-[#D4AF37]/40"
          >
            {isLoading ? 'Memeriksa Akun...' : 'Masuk akun santri'}
          </button>
        </form>
      )}
    </div>
  );

