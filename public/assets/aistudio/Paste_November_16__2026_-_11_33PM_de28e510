                <p className="font-bold text-sm text-[#0A192F]">{user.nama}</p>
                <p className="text-xs text-slate-500">Tingkat {user.tingkatan}</p>
              </div>
            </div>
            <button
              onClick={() => setCurrentView('auth')}
              className="px-3.5 py-1.5 rounded-xl border border-slate-200 text-xs font-bold text-[#0A192F] hover:bg-slate-50"
            >
              Ubah
            </button>
          </div>
        </div>
      </div>
    );
